from typing import Generic, Iterator, TypeVar, overload

_T = TypeVar("_T")
_K = TypeVar("_K")
_V = TypeVar("_V")

class object:
    def __init__(self) -> None: ...
    def __eq__(self, value: object, /) -> bool: ...

class type:
    def __init__(self, o: object, /) -> None: ...

class int:
    def __add__(self, value: int, /) -> int: ...
    def __lt__(self, value: int, /) -> bool: ...

class bool(int): ...
class float: ...

class str:
    def __add__(self, value: str, /) -> str: ...
    def __len__(self) -> int: ...

class list(Generic[_T]):
    def __init__(self) -> None: ...
    def __iter__(self) -> Iterator[_T]: ...
    def append(self, item: _T, /) -> None: ...

class dict(Generic[_K, _V]):
    def __getitem__(self, key: _K, /) -> _V: ...

class tuple(Generic[_T]): ...
class function: ...
class BaseException: ...
class Exception(BaseException): ...
class ValueError(Exception): ...

def len(obj: object, /) -> int: ...
@overload
def print(value: str, /) -> None: ...
@overload
def print(value: int, /) -> None: ...
