{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"]
}
